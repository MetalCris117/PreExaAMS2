@startuml
left to right direction

actor Cliente

rectangle "Sistema de gestion de pedidos" {
    usecase "Registrarse" as UC1
    usecase "Iniciar sesion" as UC2
    usecase "Consultar catalogo" as UC3
    usecase "Seleccionar producto" as UC4
    usecase "Crear pedido" as UC5
    usecase "Consultar historial" as UC6
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6

UC5 ..> UC2 : <<include>>
UC6 ..> UC2 : <<include>>

@enduml
